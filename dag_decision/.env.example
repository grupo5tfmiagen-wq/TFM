# Copia este archivo a ".env" y rellena los valores reales. Nunca commitees ".env".

# --- Postgres (usado por docker-compose.yml) ---
POSTGRES_USER=dag_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dag_decision_bdd
# 5433 (no el 5432 por defecto) para evitar conflicto con otras instancias/contenedores locales de Postgres.
POSTGRES_PORT=5433

# --- SQLAlchemy / Alembic (esquema de negocio) ---
DATABASE_URL=postgresql+psycopg://dag_admin:change_me@localhost:5433/dag_decision_bdd

# --- Checkpointer de Postgres para LangGraph (estado de ejecucion del grafo, pausa/reanudacion) ---
# URI plana estilo libpq (sin sufijo "+driver"), consumida por psycopg 3.
CHECKPOINTER_DATABASE_URL=postgresql://dag_admin:change_me@localhost:5433/dag_decision_bdd

# Ajuste de seguridad requerido por langgraph-checkpoint-postgres: restringe la
# deserializacion de checkpoints a tipos conocidos y seguros.
LANGGRAPH_STRICT_MSGPACK=true

# --- LangSmith (trazabilidad/observabilidad del grafo y de las llamadas LLM) ---
# Consigue una API key en https://smith.langchain.com/ (el plan gratuito es suficiente para el TFM).
LANGSMITH_TRACING=true

# Solo necesario para la region UE; omitir para el endpoint por defecto (EEUU).
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=replace_with_your_langsmith_api_key
LANGSMITH_PROJECT=dag-decision
LANGCHAIN_CALLBACKS_BACKGROUND=false

# --- OpenAI (LLM Decision Nodes) ---
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Umbral minimo de confianza para no escalar a revision humana. Para forzar
# una escalacion durante una demo, subelo temporalmente a 0.99 y reinicia Streamlit.
CONFIDENCE_THRESHOLD=0.99
